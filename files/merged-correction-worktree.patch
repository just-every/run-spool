@@ -0,0 +1,131 @@
+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import { join, dirname } from 'node:path';
+import { sentryOrganization } from '../../scripts/fixtures/sentry-organization.mjs';
