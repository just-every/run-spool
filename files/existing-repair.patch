    ci: spread the sdk shard's commands over three verify jobs
    
    verify (sdk) ran 15-28 minutes by measurement against its 25-minute cap
    (test:sentry 9-18, sentry-sdk 3-6, sdk-package 1.6-2.3, languages 1.2-2.0),
    so moving test:languages alone (about 2 minutes) cannot keep it under the cap.
    sdk keeps sentry-http and sentry-import; tunnel (about 1 minute) takes
    sentry-sdk, sdk-package and languages; execution (about 2 minutes) takes
    business-import. Same 13 verify shard names, same commands, no timeout
    raised; the Base-copy acknowledgement and source lock are regenerated.
    
    Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/.github/workflows/verify.yml b/.github/workflows/verify.yml
index da13539..ffbe848 100644
--- a/.github/workflows/verify.yml
+++ b/.github/workflows/verify.yml
@@ -300,11 +300,11 @@ jobs:
           - shard: alerts
             command: pnpm test:alerts && pnpm test:alerts-ui
           - shard: sdk
-            command: pnpm test:sentry && pnpm test:sentry:sdk && pnpm test:sdk && pnpm test:languages
+            command: node tests/sentry-http.mjs && node tests/sentry-import.mjs
           - shard: sentry-cli
             command: pnpm test:sentry:cli
           - shard: tunnel
-            command: pnpm test:tunnel
+            command: pnpm test:tunnel && pnpm test:sentry:sdk && pnpm test:sdk && pnpm test:languages
           - shard: wizard
             command: pnpm test:wizard
           - shard: agent-handoff
@@ -312,7 +312,7 @@ jobs:
           - shard: repair-recovery
             command: pnpm test:repair-recovery
           - shard: execution
-            command: pnpm test:execution
+            command: pnpm test:execution && node tests/business-import.mjs
           - shard: project-erasure
             command: pnpm test:project-erasure
           - shard: project-erasure-cap
