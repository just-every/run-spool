{
  "name": "@errors/errors-workbench",
  "version": "0.7.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-spool.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --noEmit",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "hosted": "node scripts/hosted.mjs",
    "build:app": "node scripts/build-capture.mjs && vite build",
    "verify:app": "node scripts/installer/verify.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "source:check": "node scripts/edition-authoring/cli.mjs check",
    "sourcemaps": "node packages/sdk/src/sourcemaps/bin.mjs",
    "sdk:pack": "node packages/sdk/build.mjs --pack",
    "sentry:import": "node scripts/sentry-import.mjs",
    "reproduce": "node scripts/reproduce/runner.mjs",
    "integration:sync": "node scripts/sync-integration.mjs --write",
    "integration:check": "node scripts/sync-integration.mjs --check",
    "test:journeys": "node tests/journeys.mjs",
    "test:commands": "node tests/commands.mjs",
    "test:runtimes": "node tests/sdk-runtimes.mjs",
    "test:setup": "playwright install chromium"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@jridgewell/trace-mapping": "0.3.31",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@ghostery/adblocker": "2.20.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.82",
    "@sentry/browser": "11.6.0",
    "@sentry/cli": "3.8.1",
    "@sentry/esbuild-plugin": "11.8.0",
    "@sentry/node": "11.6.0",
    "@sentry/rollup-plugin": "11.8.0",
    "@sentry/vite-plugin": "11.8.0",
    "@sentry/webpack-plugin": "11.8.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "rollup": "4.64.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "webpack": "5.112.0",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "source-map-js": "1.2.2"
    }
  }
}
