{
  "name": "@errors/errors-workbench",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-spool.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --noEmit",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "hosted": "node scripts/hosted.mjs",
    "test:runtime": "node tests/runtime.mjs",
    "test:product": "node tests/product-runtime.mjs",
    "test:ui": "node tests/triage-journey.mjs",
    "test:accessibility": "node tests/triage-journey.mjs",
    "test:domain": "node tests/product-runtime.mjs --no-browser",
    "test:origins": "node tests/browser-origins-runtime.mjs",
    "build:app": "node scripts/build-capture.mjs && vite build",
    "verify:app": "pnpm run check -- --profile first-party && pnpm source:check && node scripts/edition-authoring/cli.mjs verify-base --offline && pnpm run build:app && pnpm integration:check && pnpm typecheck && pnpm test:runtime && pnpm test:product && pnpm test:origins && pnpm test:accessibility && pnpm test:alerts && pnpm test:alerts-ui && pnpm test:sentry && pnpm test:sentry:sdk && pnpm test:sdk && pnpm test:admission && pnpm test:dev-credentials && pnpm test:commands && pnpm test:agent-handoff && pnpm test:privacy && pnpm test:repair-recovery && pnpm test:execution && pnpm test:project-erasure && pnpm test:project-erasure-cap && pnpm test:owner-erasure && pnpm test:languages",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:commands": "node tests/commands.mjs",
    "test:setup": "playwright install chromium",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "source:check": "node scripts/edition-authoring/cli.mjs check",
    "sourcemaps": "node packages/sdk/src/sourcemaps/bin.mjs",
    "sdk:pack": "node packages/sdk/build.mjs --pack",
    "sentry:import": "node scripts/sentry-import.mjs",
    "test:sentry": "node tests/sentry-http.mjs && node tests/sentry-import.mjs",
    "test:sentry:sdk": "node tests/sentry-sdk.mjs",
    "test:sdk": "node tests/sdk-package.mjs",
    "test:alerts": "node tests/alerts-runtime.mjs && node tests/alerts-immediate.mjs && node tests/alerts-edge-runtime.mjs && node tests/alerts-native.mjs && node tests/alerts-egress.mjs",
    "test:alerts-ui": "node tests/alerts-ui.mjs",
    "test:admission": "node tests/owner-claim.mjs && node tests/owner-editor.mjs && node tests/managed-sign-in.mjs",
    "test:dev-credentials": "node tests/dev-credentials.mjs",
    "test:agent-handoff": "node tests/agent-handoff.mjs",
    "test:repair-recovery": "node tests/repair-recovery.mjs",
    "test:project-erasure": "node tests/project-erasure.mjs",
    "test:project-erasure-cap": "node tests/project-erasure-cap.mjs",
    "test:privacy": "node tests/privacy-table.mjs",
    "test:owner-erasure": "node tests/owner-erasure.mjs",
    "reproduce": "node scripts/reproduce/runner.mjs",
    "test:execution": "node tests/execution-journey.mjs",
    "test:languages": "node tests/multilingual.mjs",
    "integration:sync": "node scripts/sync-integration.mjs --write",
    "integration:check": "node scripts/sync-integration.mjs --check"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@jridgewell/trace-mapping": "0.3.31",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.40",
    "@sentry/browser": "11.6.0",
    "@sentry/node": "11.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "source-map-js": "1.2.2"
    }
  }
}
