:"deployed","notnull":0,"pk":0,"type":"INTEGER"},{"name":"exercised","notnull":0,"pk":0,"type":"INTEGER"},{"name":"exercise_note","notnull":0,"pk":0,"type":"TEXT"},{"name":"revision","notnull":1,"pk":0,"type":"INTEGER"},{"name":"created","notnull":1,"pk":0,"type":"INTEGER"},{"name":"updated","notnull":1,"pk":0,"type":"INTEGER"}],"count":0,"dependencies":["issues","projects"],"name":"repairs","rowidAlias":null,"sql":"CREATE TABLE repairs(\n id TEXT PRIMARY KEY,\n project TEXT NOT NULL REFERENCES projects(id),\n issue TEXT NOT NULL REFERENCES issues(id),\n snapshot_revision INTEGER NOT NULL CHECK(snapshot_revision>=0),\n snapshot_events TEXT NOT NULL,\n snapshot_release_seq INTEGER NOT NULL CHECK(snapshot_release_seq>=0),\n link TEXT NOT NULL CHECK(length(link)<=2048),\n note TEXT NOT NULL CHECK(length(note)<=1000),\n approved INTEGER,\n merged INTEGER,\n deployed_release TEXT,\n deployed_seq INTEGER,\n deployed INTEGER,\n exercised INTEGER,\n exercise_note TEXT CHECK(exercise_note IS NULL OR length(exercise_note)<=1000),\n revision INTEGER NOT NULL CHECK(revision>=1),\n created INTEGER NOT NULL,\n updated INTEGER NOT NULL,\n CHECK((deployed_release IS NULL AND deployed_seq IS NULL AND deployed IS NULL) OR (deployed_release IS NOT NULL AND deployed_seq>=1 AND deployed IS NOT NULL)),\n CHECK((exercised IS NULL AND exercise_note IS NULL) OR (exercised IS NOT NULL AND exercise_note IS NOT NULL AND deployed IS NOT NULL AND exercised>=deployed))\n)"},{"columns":[{"name":"id","notnull":0,"pk":1,"type":"TEXT"},{"name":"reproducer","notnull":1,"pk":0,"type":"TEXT"},{"name":"project","notnull":1,"pk":0,"type":"TEXT"},{"name":"release","notnull":1,"pk":0,"type":"TEXT"},{"name":"build","notnull":1,"pk":0,"type":"TEXT"},{"name":"modules","notnull":1,"pk":0,"type":"TEXT"},{"name":"state","notnull":1,"pk":0,"type":"TEXT"},{"name":"outcome","notnull":0,"pk":0,"type":"TEXT"},{"name":"observation","notnull":0,"pk":0,"type":"TEXT"},{"name":"checks","notnull":0,"pk":0,"type":"TEXT"},{"name":"tools","notnull":0,"pk":0,"type":"TEXT"},{"name":"created","notnull":1,"pk":0,"type":"INTEGER"},{"name":"expires","notnull":1,"pk":0,"type":"INTEGER"},{"name":"claimed","notnull":0,"pk":0,"type":"INTEGER"},{"name":"finished","notnull":0,"pk":0,"type":"INTEGER"}],"count":0,"dependencies":["projects","reproducers"],"name":"reproducer_runs","rowidAlias":null,"sql":"CREATE TABLE reproducer_runs(\n id TEXT PRIMARY KEY,\n reproducer TEXT NOT NULL REFERENCES reproducers(id),\n project TEXT NOT NULL REFERENCES projects(id),\n release TEXT NOT NULL,\n build TEXT NOT NULL,\n modules TEXT NOT NULL,\n state TEXT NOT NULL CHECK(state IN ('queued','claimed','finished')),\n outcome TEXT CHECK(outcome IN ('failed','not_reproduced','reproduced')),\n observation TEXT,\n checks TEXT,\n tools TEXT,\n created INTEGER NOT NULL,\n expires INTEGER NOT NULL,\n claimed INTEGER,\n finished INTEGER,\n CHECK((state='finished')=(outcome IS NOT NULL AND observation IS NOT NULL AND checks IS NOT NULL AND finished IS NOT NULL))\n)"},{"columns":[{"name":"id","notnull":0,"pk":1,"type":"TEXT"},{"name":"project","notnull":1,"pk":0,"type":"TEXT"},{"name":"issue","notnull":1,"pk":0,"type":"TEXT"},{"name":"event","notnull":1,"pk":0,"type":"TEXT"},{"name":"defect_class","notnull":1,"pk":0,"type":"TEXT"},{"name":"support","notnull":1,"pk":0,"type":"TEXT"},{"name":"reason","notnull":0,"pk":0,"type":"TEXT"},{"name":"spec","notnull":1,"pk":0,"type":"TEXT"},{"name":"created","notnull":1,"pk":0,"type":"INTEGER"}],"count":0,"dependencies":["issues","projects"],"name":"reproducers","rowidAlias":null,"sql":"CREATE TABLE reproducers(\n id TEXT PRIMARY KEY,\n project TEXT NOT NULL REFERENCES projects(id),\n issue TEXT NOT NULL REFERENCES issues(id),\n event TEXT NOT NULL,\n defect_class TEXT NOT NULL,\n support TEXT NOT NULL CHECK(support IN ('supported','unsupported')),\n reason TEXT,\n spec TEXT NOT NULL,\n created INTEGER NOT NULL,\n CHECK((support='supported' AND reason IS NULL) OR (support='unsupported' AN