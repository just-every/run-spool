{
  "version": 1,
  "project": "just-every/spool",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "sendgrid"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "ALERT_DESTINATIONS",
      "environment": "ALERT_DESTINATIONS"
    },
    {
      "binding": "ALERT_DESTINATION_HASH_KEY",
      "environment": "ALERT_DESTINATION_HASH_KEY"
    },
    {
      "binding": "SENDGRID_EVENT_PUBLIC_KEY",
      "environment": "SENDGRID_EVENT_PUBLIC_KEY",
      "optional": true
    }
  ],
  "crons": [
    "* * * * *"
  ],
  "platforms": [
    "workers",
    "container"
  ]
}
