{
  "name": "@just-every/spool",
  "version": "0.2.0",
  "description": "Send JavaScript errors from browsers, Node and Cloudflare Workers to your own Spool installation.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/just-every/run-spool.git", "directory": "packages/sdk" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/browser.d.ts", "default": "./dist/browser.js" },
    "./browser": { "types": "./dist/browser.d.ts", "default": "./dist/browser.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" },
    "./vite": { "types": "./dist/vite.d.ts", "default": "./dist/vite.js" },
    "./rollup": { "types": "./dist/vite.d.ts", "default": "./dist/vite.js" },
    "./package.json": "./package.json"
  },
  "bin": { "spool-sourcemaps": "./dist/sourcemaps.js" },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" }
}
