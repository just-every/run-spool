{
  "schema": 1,
  "title": "Spool",
  "groups": [
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "email",
      "label": "Sign-in email",
      "help": "Choose a provider for email links and invitations, or turn email off and sign in with rer signin from the deploying checkout."
    },
    {
      "id": "alerts",
      "label": "Alerts",
      "help": "Optional. Alert rules send to the destinations listed here; leave it empty to start without any."
    }
  ],
  "fields": [
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "The first owner uses this address for sign-in. Local development opens signed in without email.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth install. Leave empty to use email links.",
      "group": "owner"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Email provider",
      "help": "Choose none deliberately to disable email. Hosted owner access then uses rer signin with deployment credentials. Local development suppresses mail.",
      "kind": "select",
      "required": true,
      "default": "resend",
      "options": [
        {
          "value": "development",
          "label": "Local development (mail suppressed)"
        },
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "cloudflare",
          "label": "Cloudflare Email Sending"
        },
        {
          "value": "none",
          "label": "Off (sign in with rer signin)"
        }
      ],
      "group": "email",
      "runtimeEditable": false
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender email",
      "kind": "email",
      "default": "",
      "required": false,
      "group": "email",
      "runtimeEditable": true,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_RECIPIENTS",
      "label": "Who email may reach",
      "kind": "select",
      "required": false,
      "default": "any",
      "options": [
        {
          "value": "any",
          "label": "Anyone Spool is told to email"
        },
        {
          "value": "owner",
          "label": "Only the owner email"
        }
      ],
      "group": "email",
      "help": "Choose Only the owner email for a tool that must never email anyone else: every message to another address is refused before it reaches the provider, including invitations, team and digest mail."
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "email",
      "runtimeEditable": false
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "email",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "label": "RER mail credential",
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "label": "Resend API key",
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "label": "SendGrid API key",
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "label": "Cloudflare API token",
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_ACCOUNT_ID",
      "label": "Cloudflare account ID",
      "kind": "text",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "cloudflare"
      },
      "group": "email"
    },
    {
      "name": "ALERT_DESTINATIONS",
      "label": "Alert destinations",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "alerts",
      "help": "Optional JSON list of mail or webhook destinations, for example [{\"id\":\"team-mail\",\"project\":\"web-app\",\"label\":\"Team mail\",\"channel\":\"mail\",\"recipient\":\"team@example.com\"}]. Webhooks also need the egress service in docs/ALERT-WEBHOOKS.md."
    },
    {
      "name": "ALERT_DESTINATION_HASH_KEY",
      "label": "Alert destination key",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "base64",
      "group": "alerts"
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
