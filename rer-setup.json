{
  "schema": 1,
  "title": "Spool",
  "groups": [
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "email",
      "label": "Sign-in email",
      "help": "Local development suppresses mail. Hosted sign-in requires an email provider or linked Auth installation."
    },
    {
      "id": "alerts",
      "label": "Alerts",
      "help": "Optional. Alert rules send to the destinations listed here; leave it empty to start without any."
    }
  ],
  "fields": [
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "The first owner uses this address for sign-in. Local development opens signed in without email.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth install. Leave empty to use email links.",
      "group": "owner"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Email provider",
      "help": "Hosted installs send real sign-in email. Local development suppresses mail.",
      "kind": "select",
      "required": true,
      "default": "resend",
      "options": [
        {
          "value": "development",
          "label": "Local development (mail suppressed)"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        }
      ],
      "group": "email",
      "runtimeEditable": false
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender email",
      "kind": "email",
      "default": "auth@localhost.test",
      "required": true,
      "group": "email",
      "runtimeEditable": true
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "email",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "label": "Resend API key",
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "label": "SendGrid API key",
          "required": true
        }
      ]
    },
    {
      "name": "ALERT_DESTINATIONS",
      "label": "Alert destinations",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "alerts",
      "help": "Optional JSON list of mail or webhook destinations, for example [{\"id\":\"team-mail\",\"project\":\"web-app\",\"label\":\"Team mail\",\"channel\":\"mail\",\"recipient\":\"team@example.com\"}]. Webhooks also need the egress service in docs/ALERT-WEBHOOKS.md."
    },
    {
      "name": "ALERT_DESTINATION_HASH_KEY",
      "label": "Alert destination key",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "base64",
      "group": "alerts"
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
