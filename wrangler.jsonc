{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "errors-errors-workbench",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "limits": {
    "cpu_ms": 30000
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{"name": "CONSOLE", "class_name": "SpoolConsole"}]
  },
  "migrations": [
    {"tag": "spool-console-v1", "new_sqlite_classes": ["SpoolConsole"]}
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "errors-local",
      "database_id": "errors-local",
      "migrations_dir": "migrations/core"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "MAIL_FROM": ""
  }
}
