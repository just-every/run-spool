{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "errors-errors-workbench",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "errors-local",
      "database_id": "errors-local",
      "migrations_dir": "migrations/core"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
